        "type": "function",
        "function": {
            "name": "read_file",
            "description": "Read a file from the Barterkin project. Path relative to /root/barterkin or absolute under it.",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "max_bytes": {"type": "integer", "default": 16384}
