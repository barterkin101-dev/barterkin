def _safe_path(p):
    """Resolve path, ensure under /root/barterkin."""
    base = _pathlib.Path(_PROJECT).resolve()
    full = (base / p).resolve() if not p.startswith('/') else _pathlib.Path(p).resolve()
    if not str(full).startswith(str(base)):
        raise ValueError(f'path escape: {p} resolves outside project')
    return full

_FORBIDDEN_CMD = ['rm -rf /', 'rm -rf ~', ':() {', 'mkfs', 'dd if=/dev/', 'shutdown', 'reboot', 'chattr -i', '/etc/passwd', 'curl ipinfo', '> /etc']

def _check_shell(cmd):
    low = cmd.lower()
    for bad in _FORBIDDEN_CMD:
        if bad.lower() in low:
            raise ValueError(f'forbidden command pattern: {bad}')

async def _tool_run_shell(args):
    cmd = args.get('command', '')
    timeout = min(int(args.get('timeout', 60) or 60), 300)
    _check_shell(cmd)
    try:
        proc = await _asyncio.create_subprocess_shell(
            cmd,
            stdout=_asyncio.subprocess.PIPE, stderr=_asyncio.subprocess.STDOUT,
            cwd=_PROJECT
        )
        try:
            stdout, _ = await _asyncio.wait_for(proc.communicate(), timeout=timeout)
        except _asyncio.TimeoutError:
            proc.kill()
            return f'TIMEOUT after {timeout}s'
        out = stdout.decode('utf-8', errors='replace')
        if len(out) > 8192:
            out = out[:4096] + f'\n... [truncated {len(out)-8192} bytes] ...\n' + out[-4096:]
        return f'exit={proc.returncode}\n{out}'
    except Exception as e:
        return f'ERROR: {e}'

async def _tool_read_file(args):
    try:
        path = _safe_path(args['path'])
        if not path.exists():
            return f'NOT FOUND: {path}'
        if path.is_dir():
            return f'IS DIR (use list_dir): {path}'
        max_b = int(args.get('max_bytes', 16384))
        data = path.read_bytes()[:max_b]
        return data.decode('utf-8', errors='replace')
    except Exception as e:
        return f'ERROR: {e}'

async def _tool_write_file(args):
    try:
        path = _safe_path(args['path'])
        # Block writing to .hermes-do-not-touch listed files
        protected = ['scripts/telegram-bot.py', 'scripts/barterkin-daemon.sh', '.hermes-do-not-touch']
        rel = str(path).replace(_PROJECT + '/', '')
        if rel in protected:
            return f'BLOCKED: {rel} is in .hermes-do-not-touch'
        path.parent.mkdir(parents=True, exist_ok=True)
        content = args.get('content', '')
        path.write_text(content)
        return f'wrote {len(content)} bytes to {rel}'
    except Exception as e:
        return f'ERROR: {e}'

async def _tool_list_dir(args):
    try:
        path = _safe_path(args.get('path', '.'))
        if not path.exists():
            return f'NOT FOUND: {path}'
        entries = []
        for it in sorted(path.iterdir())[:200]:
            kind = 'd' if it.is_dir() else 'f'
            size = it.stat().st_size if it.is_file() else 0
            entries.append(f'{kind} {size:>10}  {it.name}')
        return '\n'.join(entries) or '(empty)'
    except Exception as e:
        return f'ERROR: {e}'

async def _tool_fetch_url(args):
    try:
        url = args['url']
        async with _httpx.AsyncClient(timeout=30.0, follow_redirects=True) as cli:
            r = await cli.get(url)
            txt = r.text[:16384]
            return f'status={r.status_code}\n{txt}'
    except Exception as e:
        return f'ERROR: {e}'

async def _tool_git_commit(args):
    msg = args.get('message', 'auto-commit by barterkin bot')
    proc1 = await _asyncio.create_subprocess_shell(
        f'cd {_PROJECT} && git add -A && git -c user.name=barterkin-bot -c user.email=bot@barterkin '
        f'commit -m {repr(msg)} 2>&1 && git rev-parse --short HEAD',
        stdout=_asyncio.subprocess.PIPE, stderr=_asyncio.subprocess.STDOUT
    )
    out, _ = await proc1.communicate()
    return out.decode('utf-8', errors='replace')[:2000]

_TOOL_DISPATCH = {
    'run_shell': _tool_run_shell,
    'read_file': _tool_read_file,
    'write_file': _tool_write_file,
    'list_dir': _tool_list_dir,
    'fetch_url': _tool_fetch_url,
    'git_commit': _tool_git_commit,
}

async def _exec_tool(name, args_json):
    import json as _j
    try:
        args = _j.loads(args_json) if isinstance(args_json, str) else (args_json or {})
    except Exception:
        args = {}
    fn = _TOOL_DISPATCH.get(name)
    if not fn:
        return f'UNKNOWN TOOL: {name}'
    try:
        return await fn(args)
    except Exception as e:
        return f'TOOL ERROR: {e}'
# ─── END TOOL LAYER ─────────────────────────────────────────────────────────


async def kimi_reply(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    msg = update.effective_message
    if not msg:
        return
    user_text = msg.text or msg.caption or ''
    if not user_text:
        return
    chat_id = msg.chat_id
    _KIMI_LOG.info('kimi_reply got chat=%s from=%s text=%r', chat_id, getattr(msg.from_user, 'id', None), user_text[:80])
    # Group gate: only configured group
    if chat_id < 0 and _ALLOWED_CHAT and chat_id != _ALLOWED_CHAT:
        return
    # DM gate: only Naeem
    if chat_id > 0 and msg.from_user and msg.from_user.id != _NAEEM_UID:
        return
    # Rate limit 3s/chat
    now = _time.time()
    if now - _KIMI_LAST_TS.get(chat_id, 0) < 3:
        return
    _KIMI_LAST_TS[chat_id] = now
    raw = re.sub(r'@\w+', '', user_text).strip()
    if not raw:
        return
    _SYS = (
        "You are Barterkin Ops — a Telegram assistant for the Barterkin project "
        "(US state of Georgia — barter & local services community directory, Next.js + self-hosted "
        "Supabase on Vitalis, repo at /root/barterkin). Owner is Naeem.\n\n"
        "LANGUAGE: ALWAYS reply in English. Never use German, French, Russian, or any other language regardless of any prior context.\n\n"
        "AMBIGUOUS INPUT: If user sends a single character (?, !, k, ok, etc.) "
        "with no actionable context, ask a short clarifying question in English. "
        "Do NOT generate long unrelated content.\n\n"
        "SCOPE: Barterkin codebase, infra, business, copy, marketing, design, "
        "customers, supabase, deploys, GitHub, the telegram bot itself. If asked "
        "something clearly unrelated to Barterkin (other clients, off-topic chat), "
        "politely redirect once, then answer briefly anyway if user insists.\n\n"
        "BEHAVIOR:\n"
        "- DO the task, don't ask permission. If user says 'create a page', draft "
        "the actual page copy/component code. If they say 'add to website', produce "
        "concrete next-steps + the actual content to paste in.\n"
        "- Be CONCRETE. Give real filenames, paths, sql, code, or copy. Not abstract advice.\n"
        "- If the user shares an image with a caption, treat the caption as the task "
        "and assume the image is supporting context (you can't see it — ask only if essential).\n"
        "- For 'about / team / behind the scenes' style requests, write real marketing "
        "copy with sections, headlines, body paragraphs, CTA.\n"
        "- For follow-ups like 'yes', 'do it', 'next', use the previous turn's context — "
        "don't ask the user to repeat themselves.\n\n"
        "OUTPUT FORMAT (Telegram Markdown, keep <3500 chars):\n"
        "- Lead with one-line headline + emoji (✅ done • 🚧 in progress • ⚠️ issue • "
        "📋 list • 🔧 fix • 📊 stats • 💡 idea • 🚀 deploy • 🐛 bug • 🎨 design • ✍️ copy)\n"
        "- *bold* for key terms (single asterisks)\n"
        "- Bullets with • or numbered 1. 2.\n"
        "- `code` in single backticks, ```blocks``` for multi-line code/copy\n"
        "- Be terse. Lead with the answer. No 'I'd be happy to' fluff."
    )
    prompt = _SYS + '\n\nUser question: ' + raw
    # Send 'thinking' placeholder + keep typing action alive
    thinking_msg = None
    try:
        thinking_msg = await msg.reply_text('🤔 Thinking…')
    except Exception:
        pass

    async def _typing_loop():
        while True:
            try:
                await context.bot.send_chat_action(chat_id=chat_id, action='typing')
            except Exception:
                pass
            await _asyncio.sleep(4)

    typing_task = _asyncio.create_task(_typing_loop())
    accumulated = ''
    last_edit_ts = 0.0
    last_edit_text = ''
    try:
        history = _CHAT_HISTORY.get(chat_id, [])
        messages = [{'role': 'system', 'content': _SYS}] + list(history) + [{'role': 'user', 'content': raw}]
        headers = {
            'Authorization': f'Bearer {KIMI_API_KEY}',
            'Content-Type': 'application/json',
            'User-Agent': 'claude-code/0.1.0',
        }
        import json as _json
        MAX_TOOL_LOOPS = 60
        for _loop in range(MAX_TOOL_LOOPS):
            payload = {
                'model': KIMI_MODEL,
                'messages': messages,
                'tools': TOOLS_SCHEMA,
                'tool_choice': 'auto',
                'stream': True,
                'temperature': 0.5,
                'max_tokens': 4096,
            }
            # Track tool_calls being assembled in this turn
            tool_calls_acc = {}  # index -> {id, name, arguments_str}
            turn_text = ''
            reasoning_acc = ''
            async with _httpx.AsyncClient(timeout=_httpx.Timeout(240.0, connect=10.0)) as cli:
                async with cli.stream('POST', f'{KIMI_BASE}/chat/completions', json=payload, headers=headers) as resp:
                    if resp.status_code != 200:
                        body = (await resp.aread()).decode('utf-8','replace')[:500]
                        if thinking_msg:
                            try: await thinking_msg.edit_text(f'⚠ Kimi API {resp.status_code}: {body[:200]}')
                            except Exception: pass
                        typing_task.cancel()
                        return
                    async for line in resp.aiter_lines():
                        if not line or not line.startswith('data:'):
                            continue
                        chunk = line[5:].strip()
                        if chunk == '[DONE]':
                            break
                        try:
                            obj = _json.loads(chunk)
                            delta = obj.get('choices', [{}])[0].get('delta', {})
                        except Exception:
                            continue
                        # Reasoning content (Kimi thinking mode)
                        rc = delta.get('reasoning_content') or ''
                        if rc:
                            reasoning_acc += rc
                        # Text content
                        c = delta.get('content') or ''
                        if c:
                            turn_text += c
                            accumulated += c
                            now = _time.time()
                            if (now - last_edit_ts) >= 1.4:
                                snippet = accumulated[:3800]
                                if snippet != last_edit_text:
                                    try:
                                        if thinking_msg:
                                            await thinking_msg.edit_text(snippet + ' ▌')
                                            last_edit_text = snippet
                                            last_edit_ts = now
                                    except Exception:
                                        last_edit_ts = now
                        # Tool calls (streamed in pieces)
                        for tc in (delta.get('tool_calls') or []):
                            idx = tc.get('index', 0)
                            entry = tool_calls_acc.setdefault(idx, {'id': '', 'name': '', 'arguments': ''})
                            if tc.get('id'): entry['id'] = tc['id']
                            fn = tc.get('function', {})
                            if fn.get('name'): entry['name'] = fn['name']
                            if fn.get('arguments'): entry['arguments'] += fn['arguments']
            # End of stream for this loop iteration
            if not tool_calls_acc:
                break  # plain text reply, exit loop
            # Append assistant turn (with tool_calls) to messages
            assistant_msg = {'role': 'assistant', 'content': turn_text or None, 'tool_calls': []}
            if reasoning_acc:
                assistant_msg['reasoning_content'] = reasoning_acc
            for idx in sorted(tool_calls_acc.keys()):
                tc = tool_calls_acc[idx]
                assistant_msg['tool_calls'].append({
                    'id': tc['id'] or f'call_{idx}',
                    'type': 'function',
                    'function': {'name': tc['name'], 'arguments': tc['arguments'] or '{}'}
                })
            messages.append(assistant_msg)
            # Edit placeholder to show tool activity
            tool_names = ', '.join(t['function']['name'] for t in assistant_msg['tool_calls'])
            try:
                if thinking_msg:
                    await thinking_msg.edit_text((accumulated or '') + f'\n\n🔧 *Running:* `{tool_names}`', parse_mode='Markdown')
            except Exception:
                pass
            # Execute each tool call, append tool result, surface terminal output to user
            for tc in assistant_msg['tool_calls']:
                tname = tc['function']['name']
                targs_raw = tc['function']['arguments']
                _KIMI_LOG.info('TOOL %s args=%s', tname, targs_raw[:200])
                result = await _exec_tool(tname, targs_raw)
                _KIMI_LOG.info('TOOL %s -> %d chars', tname, len(str(result)))
                # Render command+output inline so Naeem sees what the bot is doing
                try:
                    import json as _j2
                    targs = _j2.loads(targs_raw or '{}')
                except Exception:
                    targs = {}
                # Build a human-readable command line for display
                if tname == 'run_shell':
                    cmdline = targs.get('command', '')[:300]
                    header = f'$ {cmdline}'
                elif tname == 'read_file':
                    header = f'$ cat {targs.get("path","?")}'
                elif tname == 'write_file':
                    header = f'$ write {targs.get("path","?")} ({len(targs.get("content",""))} bytes)'
                elif tname == 'list_dir':
                    header = f'$ ls {targs.get("path",".")}'
                elif tname == 'fetch_url':
                    header = f'$ curl {targs.get("url","?")[:200]}'
                elif tname == 'git_commit':
                    header = f'$ git commit -m "{targs.get("message","")[:80]}"'
                else:
                    header = f'$ {tname} {targs_raw[:200]}'
                # Truncate output for telegram: head 15 + tail 15 lines if huge
                out_str = str(result)
                lines = out_str.split('\n')
                if len(lines) > 35:
                    out_disp = '\n'.join(lines[:15]) + f'\n... [{len(lines)-30} lines truncated] ...\n' + '\n'.join(lines[-15:])
                elif len(out_str) > 2000:
                    out_disp = out_str[:1000] + f'\n... [{len(out_str)-2000} chars truncated] ...\n' + out_str[-1000:]
                else:
                    out_disp = out_str
                block = f'```\n{header}\n{out_disp}\n```'
                # Send as a separate message so Naeem sees each step
                try:
                    await update.effective_chat.send_message(block[:4000], parse_mode='Markdown')
                except Exception:
                    try:
                        await update.effective_chat.send_message(block[:4000])
                    except Exception:
                        pass
                messages.append({'role': 'tool', 'tool_call_id': tc['id'], 'content': str(result)[:8192]})
            # Loop back: Kimi sees tool results, may emit more text or more tools
        typing_task.cancel()
        if not accumulated.strip() and _loop >= MAX_TOOL_LOOPS - 1:
            accumulated = ('Hit my tool-loop limit (' + str(MAX_TOOL_LOOPS) + ' steps) without finishing. '
                           'Last actions logged. Ask me to continue from where I left off, or break the task into smaller pieces.')
        reply = (accumulated or '(empty reply)').strip()[:3800]
        # Save to per-chat history (trim to last _MEM_MAX)
        from collections import deque
        h = _CHAT_HISTORY.setdefault(chat_id, deque(maxlen=_MEM_MAX))
        h.append({'role': 'user', 'content': raw[:1500]})
        h.append({'role': 'assistant', 'content': reply[:1500]})
        # If reply is suspiciously short, log full raw accumulated for debugging
        if len(reply) < 50:
            _KIMI_LOG.warning('SHORT REPLY (%d chars): raw=%r reply=%r', len(reply), raw[:200], accumulated[:500])

        # Final render: try Markdown → HTML → plain
        sent_ok = False
        for mode in ('Markdown', 'HTML', None):
            try:
                if mode == 'HTML':
                    import re as _re2
                    htmlrep = _re2.sub(r'\*\*(.+?)\*\*', r'<b>\1</b>', reply)
                    htmlrep = _re2.sub(r'(?<!\*)\*([^*\n]+?)\*(?!\*)', r'<i>\1</i>', htmlrep)
                    htmlrep = _re2.sub(r'`([^`\n]+?)`', r'<code>\1</code>', htmlrep)
                    if thinking_msg:
                        await thinking_msg.edit_text(htmlrep, parse_mode='HTML')
                    else:
                        await msg.reply_text(htmlrep, parse_mode='HTML')
                elif mode:
                    if thinking_msg:
                        await thinking_msg.edit_text(reply, parse_mode=mode)
                    else:
                        await msg.reply_text(reply, parse_mode=mode)
                else:
                    if thinking_msg:
                        await thinking_msg.edit_text(reply)
                    else:
                        await msg.reply_text(reply)
                sent_ok = True
                _KIMI_LOG.info('kimi_reply sent %d chars (mode=%s)', len(reply), mode or 'plain')
                break
            except Exception as e:
                _KIMI_LOG.warning('parse_mode=%s failed: %s', mode, e)
        if not sent_ok:
            try:
                if thinking_msg: await thinking_msg.edit_text(reply[:3000])
                else: await msg.reply_text(reply[:3000])
            except Exception:
                pass
    except Exception as e:
        _KIMI_LOG.exception('kimi_reply failed')
        try:
            await msg.reply_text(f'⚠ Kimi error: {e}')
        except Exception:
            pass


def run_poll() -> None:
    if not TOKEN:
        print("ERROR: Set TELEGRAM_BOT_TOKEN env var")
        sys.exit(1)
    application = Application.builder().token(TOKEN).build()
    application.add_handler(CommandHandler("start", cmd_start))
    application.add_handler(CommandHandler("status", cmd_status))
    application.add_handler(CommandHandler("tasks", cmd_tasks))
    application.add_handler(CommandHandler("approvals", cmd_approvals))
    application.add_handler(CallbackQueryHandler(handle_callback))
    application.add_handler(MessageHandler((filters.TEXT & ~filters.COMMAND) | filters.PHOTO | filters.Document.ALL, kimi_reply))
    application.run_polling(allowed_updates=Update.ALL_TYPES, drop_pending_updates=True)


async def run_once() -> None:
    if not TOKEN:
        print("ERROR: Set TELEGRAM_BOT_TOKEN env var")
        sys.exit(1)
    application = Application.builder().token(TOKEN).build()
    mode = sys.argv[1] if len(sys.argv) > 1 else "status"
    async with application:
        if mode == "status":
            await send_status(application)
        elif mode == "ask":
            task = sys.argv[2] if len(sys.argv) > 2 else "unknown task"
            details = sys.argv[3] if len(sys.argv) > 3 else ""
            await send_approval(application, task, details)
        else:
            print(f"Unknown mode: {mode}")


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "poll"
    if mode == "poll":
        run_poll()
    else:
        asyncio.run(run_once())
